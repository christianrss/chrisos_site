digraph privilege {
  graph [rankdir=TB, bgcolor="#faf9f4", pad="0.3", nodesep="0.4", ranksep="0.6"];
  node [shape=box, style="rounded,filled", fillcolor="#e7ecef", fontname="Arial", fontsize=12, margin="0.3,0.18"];
  edge [fontname="Arial", fontsize=10];
  user [label="User RIP / RSP / arguments"];
  gate [label="IDT gate and entry frame"];
  dispatch [label="irq_dispatch / syscall_dispatch"];
  span [label="Range and page checks"];
  service [label="Service and object ownership"];
  error [label="Error or process fault"];
  ret [label="Validated return state"];
  user -> gate [label="INT 0x80"];
  gate -> dispatch;
  dispatch -> span [label="pointer argument"];
  span -> service [label="accepted"];
  span -> error [label="rejected"];
  dispatch -> service [label="scalar arguments"];
  service -> ret;
  service -> error;
  error -> ret;
  ret -> user [label="normal return",constraint=false];
}
