digraph usb_storage {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];
  pci [label="PCI classe 0C0300\nUHCI I/O BAR4", fillcolor="#ffffff"];
  dma [label="arena DMA32: 4 paginas / 16 KiB\nframe list + QH/TDs + buffers"];
  enum [label="2 root ports\nreset -> SET_ADDRESS\nconfiguration descriptor"];
  bind [label="bulk IN + bulk OUT\nmatcher atual nao exige classe MSC"];
  bot [label="USB BOT\nCBW -> dados -> CSW"];
  scsi [label="SCSI\nREAD CAPACITY(10)\nREAD(10) / WRITE(10)"];
  block [label="BlockDevice usb\nsuposicao de 512 bytes\n<= 8 setores/comando\nflush = 0", fillcolor="#dddddd"];
  xhci [label="Caminho xHCI separado\nHID keyboard/mouse apenas\nsem MSC", style="rounded,dashed"];
  pci -> dma -> enum -> bind -> bot -> scsi -> block;
  xhci -> bind [style=dashed, label="nao conectado ao storage"];
}