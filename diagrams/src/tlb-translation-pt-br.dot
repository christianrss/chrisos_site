digraph G {
  rankdir=LR;
  graph [bgcolor="transparent", pad="0.2"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];
  va [label="Endereço virtual"];
  tlb [label="Consulta à TLB"];
  hit [label="Tradução + permissões em cache"];
  walk [label="Page-table walk\nCR3 -> PML4 -> PDPT -> PD -> PT"];
  pa [label="Endereço físico / acesso"];
  inval [label="Mapping muda\nINVLPG ou troca de CR3"];
  va -> tlb;
  tlb -> hit [label="hit"];
  hit -> pa;
  tlb -> walk [label="miss"];
  walk -> pa;
  inval -> tlb [label="invalida entrada obsoleta"];
}