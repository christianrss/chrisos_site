digraph cache {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  cpu [label="CPU: instruction / data access"];
  l1i [label="L1 instruction cache"];
  l1d [label="L1 data cache"];
  l2 [label="Lower cache levels\n(topology depends on CPU)"];
  ram [label="Memory controller / DRAM"];
  io [label="Device register access\n(memory type + ordering)"];
  cpu -> l1i; cpu -> l1d; cpu -> io;
  l1i -> l2 [label="miss"]; l1d -> l2 [label="miss / writeback"];
  l2 -> ram [label="miss / writeback"];
}
