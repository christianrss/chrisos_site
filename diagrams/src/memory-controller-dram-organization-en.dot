digraph dram {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.25", nodesep="0.32", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  req [label="Physical memory request\naddress + read/write + requester"];
  ctrl [label="Memory controller\nqueues + address decoder + scheduler", fillcolor="#f7f7f7"];
  ch [label="Channel\nshared command/data resources"];
  rank [label="Rank"];
  bank0 [label="Bank A\nopen row = R10"];
  bank1 [label="Bank B\nopen row = R42"];
  row [label="Row buffer / sense amps"];
  data [label="Burst data transfer"];
  backing [label="Backing memory bytes\n(functional data state)", shape=box3d, fillcolor="#ffffff"];

  req -> ctrl;
  ctrl -> ch;
  ch -> rank;
  rank -> bank0;
  rank -> bank1;
  bank0 -> row [label="ACT/PRE"];
  bank1 -> row [label="ACT/PRE"];
  row -> data [label="READ/WRITE"];
  data -> backing [label="complete"];
  ctrl -> req [style=dashed, label="completion/backpressure", constraint=false];
}
