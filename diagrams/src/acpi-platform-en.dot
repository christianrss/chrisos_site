digraph acpi_platform {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  uefi [label="UEFI / bootloader handoff"];
  rsdp [label="RSDP\nsignature + checksums"];
  root [label="XSDT / RSDT\ntable directory"];
  madt [label="MADT\nCPUs + LAPIC + IOAPIC + ISOs"];
  mcfg [label="MCFG\nPCIe ECAM segments"];
  fadt [label="FADT / FACP\nSCI + reset + PM + DSDT/FACS"];
  dsdt [label="DSDT + SSDTs\nAML Definition Blocks"];
  aml [label="AML namespace/runtime\n_STA _CRS _PRT _PIC _OSC"];
  consumers [label="Kernel consumers\nSMP / IRQ / PCIe / power / timers"];
  current [label="Current ChrisOS\nlegacy RSDP scan\nprints APIC/MCFG/FACP", fillcolor="#f7f7f7"];

  uefi -> rsdp;
  rsdp -> root;
  root -> madt;
  root -> mcfg;
  root -> fadt;
  root -> dsdt;
  fadt -> dsdt;
  dsdt -> aml;
  madt -> consumers;
  mcfg -> consumers;
  fadt -> consumers;
  aml -> consumers;

  current -> rsdp [style=dashed, label="partial discovery"];
  current -> madt [style=dashed, label="signature only"];
  current -> mcfg [style=dashed, label="signature only"];
  current -> fadt [style=dashed, label="signature only"];
}