digraph pci_pcie {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  cpu [label="CPU / ChrisOS"];
  cfg [label="PCI configuration core\nBDF + config registers"];
  legacy [label="Legacy backend\n0xCF8 / 0xCFC\n256 B/function"];
  ecam [label="Future ECAM backend\nMCFG\n4096 B/function"];
  root [label="Root Complex"];
  bridge [label="PCIe bridge / switch port"];
  ep1 [label="Endpoint\nNVMe / AHCI / xHCI"];
  ep2 [label="Endpoint\nVirtIO GPU / block / net"];
  bar [label="BAR resources\nI/O or MMIO"];
  caps [label="Capabilities\nPCIe / MSI / MSI-X / vendor"];
  dma [label="DMA / interrupts"];

  cpu -> cfg;
  cfg -> legacy [label="current"];
  cfg -> ecam [label="future"];
  legacy -> root;
  ecam -> root;
  root -> bridge;
  bridge -> ep1;
  bridge -> ep2;
  ep1 -> bar;
  ep2 -> bar;
  ep2 -> caps;
  bar -> dma;
  caps -> dma;
}