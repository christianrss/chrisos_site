digraph branch_prediction {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.25", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  fetch [label="Fetch RIP"];
  predict [label="Predictor\ndirection + BTB/RAS", shape=diamond, fillcolor="#f7f7f7"];
  spec [label="Speculative fetch/decode\nsequence + checkpoint"];
  resolve [label="Branch execute\nactual direction + target"];
  good [label="Prediction correct\nkeep younger work", fillcolor="#dddddd"];
  bad [label="Mispredict recovery\nflush younger work\nrestore checkpoint", fillcolor="#dddddd"];
  redirect [label="Correct next RIP"];

  fetch -> predict -> spec -> resolve;
  resolve -> good [label="match"];
  resolve -> bad [label="mismatch"];
  good -> fetch [style=dashed, label="continue", constraint=false];
  bad -> redirect -> fetch;
  resolve -> predict [style=dotted, label="train at defined point", constraint=false];
}
