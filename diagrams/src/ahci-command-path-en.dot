digraph ahci {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.25", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  pci [label="PCI class 01:06\nAHCI controller"];
  bar [label="BAR5 -> MMIO window"];
  port [label="Implemented SATA port\nDET == 3"];
  ctl [label="4 KiB DMA control page\nCLB/FIS/cmd table", shape=box3d, fillcolor="#ffffff"];
  data [label="4 KiB DMA data page", shape=box3d, fillcolor="#ffffff"];
  fis [label="H2D Register FIS\nREAD DMA EXT / WRITE DMA EXT"];
  ci [label="PxCI slot 0\npolled completion"];
  bd [label="BlockDevice\n512-byte sectors"];
  disk [label="SATA device"];

  pci -> bar -> port;
  port -> ctl;
  port -> data;
  ctl -> fis -> ci -> disk;
  disk -> data;
  data -> bd;
}
