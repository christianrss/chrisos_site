digraph gc_libraries {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.25", nodesep="0.30", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  src [label="source ChrisC\n#include / .LST", fillcolor="#ffffff"];
  cc [label="compiler ChrisC\nABI + exports"];
  clv [label="aplicacao CLV"];
  cls [label="runtime library CLS\nexports / imports / types"];
  cla [label="managed assembly CLA\nIL verificado / refs"];
  proc [label="process mapping\nPROC_LIB_VIRT"];
  gc [label="GC\nroots + types + nursery\nmark/sweep"];
  vm [label="runtime CLVM\nSYS: lib_load / gc_alloc / cla_load"];

  src -> cc;
  cc -> clv;
  cc -> cls;
  cls -> proc;
  cls -> gc [label="type metadata"];
  cla -> gc [label="managed types"];
  vm -> cls [label="load/reload"];
  vm -> cla [label="load"];
  vm -> gc [label="alloc/collect"];
}
