digraph vblk {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];
  pci [label="PCI 1AF4:1042 / 1001\ncapabilities VirtIO modernas", fillcolor="#ffffff"];
  caps [label="cfg 1 common\ncfg 2 notify\ncfg 3 ISR opcional\ncfg 4 device config"];
  feat [label="status 0 -> 1 -> 3 -> 11\nsomente VIRTIO_F_VERSION_1\ndepois DRIVER_OK = 15"];
  q [label="split virtqueue, size 4\ndesc @ 0x000\navail @ 0x040\nused @ 0x800", shape=box3d];
  d0 [label="desc 0\nheader de 16 bytes\nNEXT -> 1"];
  d1 [label="desc 1\npagina de dados 4 KiB\nNEXT -> 2\nWRITE em reads"];
  d2 [label="desc 2\nstatus de 1 byte\nDEVICE_WRITE"];
  notify [label="avail.idx++\nnotify queue 0"];
  dev [label="Device VirtIO Block"];
  used [label="poll used.idx + status\nISR opcional read-to-clear"];
  bdev [label="BlockDevice virtio-blk\n<= 8 setores/request\nflush = 0", fillcolor="#dddddd"];
  pci -> caps -> feat -> q;
  q -> d0 -> d1 -> d2 -> notify -> dev -> used -> bdev;
}