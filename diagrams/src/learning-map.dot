 kernel [label="05 · Kernel\nMemory, privilege, concurrency"];
 lang [label="06 · Languages / Linguagens\nCompiler, CLVM, native tools"];
 storage [label="07 · Storage / Armazenamento\nBlocks, ChrisFS, recovery"];
 pixels [label="08 · Pixels and desktop\nBuffers, input, windows"];
 graphics [label="09 · Graphics / Gráficos\nGeometry, GPU, shaders"];
 net [label="10 · Networks / Redes\nPackets and protocol state"];
