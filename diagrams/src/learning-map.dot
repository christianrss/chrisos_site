digraph curriculum {
 graph [rankdir=TB, bgcolor="#faf9f4", pad="0.25", nodesep="0.25", ranksep="0.45"];
 node [shape=box, style="rounded,filled", fillcolor="#ecebe4", fontname="Helvetica", fontsize=12];
