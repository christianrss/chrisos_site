digraph linker_script {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  objs [label="Objetos de entrada\n.text.* / .rodata.* / .data.* / .bss.*\nsections Limine"];
  script [label="kernel/metal/linker.ld\nPHDRS + SECTIONS + expressions"];
  loc [label="Location counter '.'\n0xffffffff80000000\nALIGN + reservas sinteticas"];
  req [label=".limine_requests\nKEEP\nPT_LOAD RW"];
  text [label=".text + .rodata\nPT_LOAD RX"];
  data [label=".data + .bss\nstack 1 MiB\nPT_LOAD RW"];
  syms [label="Symbols sinteticos\n__kernel_start/end\n__stack_bottom/top"];
  elf [label="kernel.elf\nprogram headers ELF64"];
  limine [label="Limine\nmapeia e entra em kstart"];
  chrisld [label="ChrisLd atual\nRX + RW opcional\nsem paridade de producao", fillcolor="#f7f7f7"];

  objs -> script;
  script -> loc;
  loc -> req;
  loc -> text;
  loc -> data;
  loc -> syms;
  req -> elf;
  text -> elf;
  data -> elf;
  syms -> elf;
  elf -> limine;
  chrisld -> elf [style=dashed, label="paridade futura"];
}