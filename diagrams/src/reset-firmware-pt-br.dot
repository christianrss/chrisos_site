digraph reset_firmware {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  reset [label="reset x86\nCS.base=FFFF0000h\nEIP=FFF0h"];
  sec [label="Inicio do firmware / SEC\nambiente temporario"];
  pei [label="PEI\nDRAM + memoria permanente\nhandoff HOB"];
  dxe [label="DXE\ndrivers + Boot Services"];
  bds [label="BDS / UEFI Boot Manager"];
  efi [label="BOOTX64.EFI\naplicacao EFI Limine"];
  limine [label="Limine\nloader ELF + paging + protocolo"];
  info [label="Respostas Limine\nFB + HHDM + memmap + MP"];
  kernel [label="ELF higher-half ChrisOS\nENTRY(kstart)"];
  runtime [label="Init ChrisOS\nPMM / MM / SMP / FS / desktop"];
  chrisvm [label="ChrisVM v1\nboot guest direto em long mode", fillcolor="#f7f7f7"];

  reset -> sec -> pei -> dxe -> bds -> efi -> limine;
  limine -> info;
  limine -> kernel;
  info -> kernel;
  kernel -> runtime;
  chrisvm -> kernel [style=dashed, label="futuro protocolo do kernel real"];
}