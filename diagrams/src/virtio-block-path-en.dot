digraph vblk {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];
  pci [label="PCI 1AF4:1042 / 1001\nmodern VirtIO capabilities", fillcolor="#ffffff"];
  caps [label="cfg 1 common\ncfg 2 notify\ncfg 3 ISR optional\ncfg 4 device config"];
  feat [label="status 0 -> 1 -> 3 -> 11\nVIRTIO_F_VERSION_1 only\nthen DRIVER_OK = 15"];
  q [label="split virtqueue, size 4\ndesc @ 0x000\navail @ 0x040\nused @ 0x800", shape=box3d];
  d0 [label="desc 0\n16-byte request header\nNEXT -> 1"];
  d1 [label="desc 1\n4 KiB data page\nNEXT -> 2\nWRITE flag on reads"];
  d2 [label="desc 2\n1-byte status\nDEVICE_WRITE"];
  notify [label="avail.idx++\nnotify queue 0"];
  dev [label="VirtIO Block device"];
  used [label="poll used.idx + status\noptional ISR read-to-clear"];
  bdev [label="BlockDevice virtio-blk\n<= 8 sectors/request\nflush = 0", fillcolor="#dddddd"];
  pci -> caps -> feat -> q;
  q -> d0 -> d1 -> d2 -> notify -> dev -> used -> bdev;
}