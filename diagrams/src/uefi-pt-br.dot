digraph uefi {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.25", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", fontname="monospace"];
  edge [fontname="monospace"];

  fw [label="firmware UEFI"];
  st [label="EFI System Table\nBootServices + RuntimeServices\nConfigurationTable[]"];
  bm [label="UEFI Boot Manager\nBootOrder / fallback"];
  esp [label="EFI System Partition\nEFI/BOOT/BOOTX64.EFI"];
  limine [label="imagem EFI do Limine"];
  bs [label="Boot Services\nprotocols + memory map\nGOP + filesystem"];
  exit [label="GetMemoryMap\nMapKey\nExitBootServices"];
  kernel [label="kernel ELF ChrisOS\nprotocolo Limine"];
  info [label="bootinfo ChrisOS\nFB + HHDM + memmap + MP"];
  runtime [label="Runtime Services\nintegracao opcional do OS", fillcolor="#f7f7f7"];
  installer [label="instalador ChrisOS\nGPT + writer ESP\nFAT16-style atual", fillcolor="#f7f7f7"];

  fw -> st;
  st -> bm;
  bm -> esp;
  esp -> limine;
  st -> bs;
  bs -> limine;
  limine -> exit;
  exit -> kernel;
  kernel -> info;
  st -> runtime [style=dashed, label="apos handoff se preservado"];
  installer -> esp [style=dashed, label="grava midia do proximo boot"];
}